                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.payload || body;",
                  "if (Array.isArray(data) && data[0] && data[0]._id) {",
                  "  pm.environment.set('orderId', data[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders"
