{
  "info": {
    "_postman_id": "shipnow-clase-3-collection",
    "name": "ShipNow Clase-3",
    "description": "Manejo profesional de errores.\n\n1. Importá collection + environment.\n2. Seleccioná `ShipNow Clase-3 Local`.\n3. Levantá la API (root = start; para probar la clave, corré desde `docs-clase/demo/solucion/` o copiá solucion → root).\n4. Folder `00` = happy path. Folder `02` = errores de negocio + técnicos (Mongo/Express).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Happy path",
      "item": [
        {
          "name": "1. Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "2. POST seed all",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Seed 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.payload || body;",
                  "pm.test('seed users/orders/deliveries', function () {",
                  "  pm.expect(data.users.inserted).to.eql(Number(pm.environment.get('seedQty')));",
                  "  pm.expect(data.orders.inserted).to.eql(Number(pm.environment.get('seedQty')));",
                  "  pm.expect(data.deliveries.inserted).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/mocks/seed?qty={{seedQty}}"
          }
        },
        {
          "name": "3. GET users (guardar userId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Users 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.payload || body;",
                  "if (Array.isArray(data) && data[0] && data[0]._id) {",
                  "  pm.environment.set('userId', data[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "4. GET user by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User by id 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "5. GET orders (guardar orderId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
