                  "pm.test('INVALID_ID', function () {",
                  "  pm.expect(body.error).to.eql('INVALID_ID');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/id-malo"
          }
        },
