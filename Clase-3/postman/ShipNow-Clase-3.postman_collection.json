    {
      "name": "02 - Errores",
      "item": [
        {
          "name": "User inexistente → USER_NOT_FOUND",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('USER_NOT_FOUND', function () {",
                  "  pm.expect(body.status).to.eql('error');",
                  "  pm.expect(body.error).to.eql('USER_NOT_FOUND');",
                  "});",
                  "",
                  "if (body.message) {",
                  "  pm.environment.set('userNotFoundMessage', body.message);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/000000000000000000000099",
            "description": "User que no existe. En el start el message es \"Usuario no encontrado\". El request siguiente (PUT) es el mismo 404 con otro texto."
          }
        },
        {
          "name": "Update user inexistente → otro message, mismo 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('message de update', function () {",
                  "  pm.expect(body.status).to.eql('error');",
                  "  pm.expect(body.message).to.eql('no se encontro el usuario');",
                  "});",
                  "",
                  "const getMessage = pm.environment.get('userNotFoundMessage');",
                  "if (getMessage) {",
                  "  pm.test('mismo 404, message distinto al GET', function () {",
                  "    pm.expect(body.message).to.not.eql(getMessage);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ana\"\n}"
            },
            "url": "{{baseUrl}}/api/users/000000000000000000000099",
            "description": "Mismo id que el GET de user inexistente. findById tira \"Usuario no encontrado\" y update tira \"no se encontro el usuario\". Los dos son 404: el message no alcanza como contrato."
          }
        },
        {
          "name": "ID mal formado → INVALID_ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
